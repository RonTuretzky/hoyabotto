  {
    "type": "function",
    "function": {
      "name": "robot_set_gripper",
      "description": "Direct gripper encoder target within current owner selected scope; saved range and supervision enforced. Stall does not establish grasp success. Validates first, then enables only this gripper if released and moves through the sole owner; failure triggers STOP cleanup. Right-gripper execution uses fixed measured-progress waypoints up to48ticks, a1s no-progress guard, and20tick final endpoint tolerance with directed-travel and three fresh stable samples; reports raw endpoint error, not verified jaw state. Other position tools do not auto-enable. Commandable gripper ranges: left: 1279..2815 inclusive ticks; right: 1274..2820 inclusive ticks. Raw calibration endpoints are invalid command targets; no clamping.",
      "parameters": {
        "type": "object",
        "properties": {
          "arm": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ]
          },
          "position_ticks": {
            "type": "integer",
            "description": "Commandable integer encoder ticks: left: 1279..2815 inclusive ticks; right: 1274..2820 inclusive ticks"
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 25
          }
        },
        "required": [
          "arm",
          "position_ticks"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "arm": {
                  "const": "left"
                }
              },
              "required": [
                "arm"
              ]
            },
            "then": {
              "properties": {
                "position_ticks": {
                  "minimum": 1279,
                  "maximum": 2815
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "arm": {
                  "const": "right"
                }
              },
              "required": [
                "arm"
              ]
            },
            "then": {
              "properties": {
                "position_ticks": {
                  "minimum": 1274,
                  "maximum": 2820
                }
              }
            }
          }
        ]
      }
    }
  },
